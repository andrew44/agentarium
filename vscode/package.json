{
  "name": "tokenomics-status",
  "publisher": "tokenomics",
  "displayName": "tokenomics: Copilot premium requests",
  "description": "Copilot's premium requests in the status bar: left this month, the pace and the day they run out at it.",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/andrew44/tokenomics" },
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "tokenomics.status.refresh", "title": "tokenomics: Refresh the status bar" },
      { "command": "tokenomics.status.dashboard", "title": "tokenomics: Open the dashboard" }
    ]
  }
}
